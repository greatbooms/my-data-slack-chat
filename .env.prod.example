# NAS 운영 환경 예시입니다. 실제 값은 NAS 배포 경로의 `.env.prod`에 작성하세요.
# 이 파일에는 실제 비밀값을 넣지 않습니다.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=50506

# NAS에서 DB 컨테이너가 호스트 포트 15432로 열려 있는 경우의 예시입니다.
# Spring Boot는 Prisma/Node의 postgresql:// 형식이 아니라 jdbc:postgresql:// 형식을 사용합니다.
DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/my_data?currentSchema=public
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# 삭제되지 않은 관리자 계정이 없을 때 최초 1회 생성할 관리자 계정입니다.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=관리자

# Slack 수신 방식입니다. NAS 운영에서는 Socket Mode 또는 HTTP Events API 중 필요한 방식만 켭니다.
SLACK_SOCKET_MODE_ENABLED=false
SLACK_HTTP_EVENTS_ENABLED=false
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Notion 데이터소스 수집을 사용할 때 채웁니다.
NOTION_API_TOKEN=
NOTION_API_VERSION=2026-03-11
NOTION_BASE_URL=https://api.notion.com
NOTION_CONNECT_TIMEOUT=5s
NOTION_REQUEST_TIMEOUT=30s

# 임베딩 설정입니다. 현재 구현은 결정적 임베딩 클라이언트를 사용합니다.
EMBEDDING_MODEL=deterministic-1536

# LLM provider입니다. 실제 답변 생성을 켤 때 openai 또는 claude로 변경합니다.
MY_DATA_LLM_PROVIDER=stub
MY_DATA_LLM_MAX_INPUT_CHUNKS=5
MY_DATA_LLM_MAX_CHARS_PER_CHUNK=1200
MY_DATA_LLM_MAX_OUTPUT_TOKENS=700
MY_DATA_LLM_CONNECT_TIMEOUT=5s
MY_DATA_LLM_REQUEST_TIMEOUT=30s

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_API_VERSION=2023-06-01
